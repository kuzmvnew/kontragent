{
  "ruleset_version": "risk-rules-2.0.0",
  "valid_from": "2026-09-17",
  "policy_note": "Product Recovery thresholds are configurable product policy, not statutory limits.",
  "rules": [
    {
      "rule_id": "REGISTRATION_STATUS",
      "rule_version": "2.0.0",
      "section_code": "registration",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["company.status", "company.master_data_date"],
      "calculation": null,
      "thresholds": {"active_values": ["ACTIVE"]},
      "severity": "HIGH",
      "hard_blocker": false,
      "freshness_policy": {"use_master_data_date": true},
      "materiality_policy": {},
      "deal_context_policy": {},
      "explanation_template": "Unknown registration status is incomplete coverage, never a completed check.",
      "recommendation": "Verify current registration status in EGRUL/EGRIP.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "FINANCIAL_RESULT",
      "rule_version": "2.0.0",
      "section_code": "finance",
      "profile": ["GENERAL_LE", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"published_financials_available": true},
      "required_facts": ["finance.revenue", "finance.expenses", "finance.period"],
      "calculation": "revenue - expenses",
      "thresholds": {"material_loss_rub": "1000000", "material_loss_ratio": "0.20"},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"latest_full_year": true},
      "materiality_policy": {"zero_revenue_requires_review": true},
      "deal_context_policy": {},
      "explanation_template": "A loss is a financial signal and is never evaluated with the registration rule.",
      "recommendation": "Review the latest financial statements and loss dynamics.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "TAX_DEBT_TIERED",
      "rule_version": "2.0.0",
      "section_code": "taxes",
      "profile": ["GENERAL_LE", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_type": "legal"},
      "required_facts": ["tax_debt.total_debt"],
      "calculation": "tax_debt.total_debt / revenue.same_or_latest_full_period when revenue > 0",
      "thresholds": {
        "attention_absolute_rub": "100000",
        "high_absolute_rub": "10000000",
        "attention_ratio": "0.01",
        "high_ratio": "0.25",
        "ratio_quality_review": "10.0"
      },
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"dataset_status_required": ["current", "manual", "user_triggered"]},
      "materiality_policy": {"high_requires_absolute_and_relative_support": true, "show_numerator_denominator": true},
      "deal_context_policy": {},
      "explanation_template": "Debt tiers use absolute amount, company scale, source date and a data-quality gate.",
      "recommendation": "Check debt details and obtain current settlement evidence.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "TAX_OFFENCE_PRESENT",
      "rule_version": "2.0.0",
      "section_code": "taxes",
      "profile": ["GENERAL_LE", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_type": "legal"},
      "required_facts": ["tax_offence.fine_amount"],
      "calculation": null,
      "thresholds": {},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"dataset_status_required": ["current"]},
      "materiality_policy": {"do_not_invent_offence_type": true},
      "deal_context_policy": {},
      "explanation_template": "The source proves a published offence document and fine, not an unpublished offence type.",
      "recommendation": "Review the dated FNS document and fine amount.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "ACTIVE_BANKRUPTCY_PROCEDURE",
      "rule_version": "2.0.0",
      "section_code": "bankruptcy",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["legal_event.event_type", "bankruptcy_check.result"],
      "calculation": null,
      "thresholds": {},
      "severity": "CRITICAL",
      "hard_blocker": true,
      "freshness_policy": {"active_event_required": true},
      "materiality_policy": {"intent_is_not_procedure": true, "liquidation_is_not_bankruptcy": true},
      "deal_context_policy": {},
      "explanation_template": "Only evidence-backed active proceedings are critical; completed proceedings and liquidation stay separate.",
      "recommendation": "Require legal review before proceeding.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "COURT_ACTIVITY",
      "rule_version": "2.0.0",
      "section_code": "litigation",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["court.role", "court.case_count", "court.coverage"],
      "calculation": "defendant_claim_amount / revenue when revenue > 0",
      "thresholds": {"ratio_warning": "0.25"},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"targeted_cache": true},
      "materiality_policy": {"claim_is_not_debt": true, "partial_coverage_is_not_risk": true},
      "deal_context_policy": {},
      "explanation_template": "Court facts and source coverage are evaluated separately.",
      "recommendation": "Review roles, stages and primary court documents.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "PROTECTED_REGULATORY_CHECK",
      "rule_version": "2.0.0",
      "section_code": "compliance",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["protected_check.result"],
      "calculation": null,
      "thresholds": {"max_age_days": 30},
      "severity": "HIGH",
      "hard_blocker": false,
      "freshness_policy": {"max_age_days": 30},
      "materiality_policy": {"human_action_is_not_not_found": true},
      "deal_context_policy": {},
      "explanation_template": "Only a completed saved result is clean; challenge and missing access remain incomplete.",
      "recommendation": "Continue the official human-assisted flow when required.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    }
  ]
}
