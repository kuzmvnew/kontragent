{
  "ruleset_version": "risk-rules-1.0.0",
  "valid_from": "2026-09-17",
  "rules": [
    {
      "rule_id": "REGISTRATION_STATUS",
      "rule_version": "1.0.0",
      "section_code": "registration",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["company.status"],
      "calculation": null,
      "thresholds": {"active_values": ["ACTIVE"]},
      "severity": "HIGH",
      "hard_blocker": false,
      "freshness_policy": {"use_master_data_date": true},
      "materiality_policy": {},
      "deal_context_policy": {},
      "explanation_template": "Registration status is evaluated from the master registry fact.",
      "recommendation": "Verify the current registration status and source date.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "TAX_DEBT_PRESENT",
      "rule_version": "1.0.0",
      "section_code": "taxes",
      "profile": ["GENERAL_LE", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_type": "legal"},
      "required_facts": ["tax_debt.total_debt"],
      "calculation": "tax_debt.total_debt / revenue.last_full_year when revenue > 0",
      "thresholds": {"absolute_warning_rub": "1000000", "ratio_warning": "0.10"},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"dataset_status_required": ["current", "manual", "user_triggered"]},
      "materiality_policy": {"show_numerator_denominator": true},
      "deal_context_policy": {},
      "explanation_template": "Show debt amount, source date and ratio only when a valid revenue denominator exists.",
      "recommendation": "Check debt details and obtain confirmation of settlement where material.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "TAX_OFFENCE_PRESENT",
      "rule_version": "1.0.0",
      "section_code": "taxes",
      "profile": ["GENERAL_LE", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_type": "legal"},
      "required_facts": ["tax_offence.fine_amount"],
      "calculation": null,
      "thresholds": {},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"dataset_status_required": ["current"]},
      "materiality_policy": {"do_not_invent_offence_type": true},
      "deal_context_policy": {},
      "explanation_template": "The source proves a published offence document and fine, not an unpublished offence type.",
      "recommendation": "Review the dated FNS document and fine amount.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "ACTIVE_BANKRUPTCY_PROCEDURE",
      "rule_version": "1.0.0",
      "section_code": "bankruptcy",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["legal_event.event_type"],
      "calculation": null,
      "thresholds": {},
      "severity": "CRITICAL",
      "hard_blocker": true,
      "freshness_policy": {"active_event_required": true},
      "materiality_policy": {},
      "deal_context_policy": {},
      "explanation_template": "Only an evidence-backed active bankruptcy procedure creates this signal; liquidation stays separate.",
      "recommendation": "Require legal review before proceeding.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "COURT_ACTIVITY",
      "rule_version": "1.0.0",
      "section_code": "litigation",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["court.loaded_case_count"],
      "calculation": "claim_amount / revenue when revenue > 0",
      "thresholds": {"ratio_warning": "0.25"},
      "severity": "MEDIUM",
      "hard_blocker": false,
      "freshness_policy": {"targeted_cache": true},
      "materiality_policy": {"claim_is_not_debt": true, "partial_sample_must_be_labelled": true},
      "deal_context_policy": {},
      "explanation_template": "Court claims are shown as claims, never as confirmed debt.",
      "recommendation": "Review roles, case stages and primary court documents.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    },
    {
      "rule_id": "PROTECTED_REGULATORY_CHECK",
      "rule_version": "1.0.0",
      "section_code": "compliance",
      "profile": ["GENERAL_LE", "IP", "NEW_COMPANY", "FINANCIAL_ORG", "NON_PROFIT"],
      "applicability_conditions": {"entity_exists": true},
      "required_facts": ["protected_check.result"],
      "calculation": null,
      "thresholds": {"max_age_days": 30},
      "severity": "HIGH",
      "hard_blocker": false,
      "freshness_policy": {"max_age_days": 30},
      "materiality_policy": {},
      "deal_context_policy": {},
      "explanation_template": "Use only a saved completed public check; challenge or missing check is not clean.",
      "recommendation": "Repeat the official human-assisted check if stale or unavailable.",
      "public_visibility": true,
      "valid_from": "2026-09-17",
      "valid_to": null
    }
  ]
}
