# PostgreSQL 18.6 administrative DSN used only to create random sp01_* databases.
# The target cluster must set: nextcompany.environment = 'staging'
STAGING_DB_ADMIN_URL=postgresql+psycopg://nextcompany_staging_admin:CHANGE_ME@127.0.0.1:5432/postgres
STAGING_ACCEPTANCE_CONFIRM=STAGING-PARITY-01

# Persistent staging services use separate databases and credentials.
DATABASE_URL=postgresql+psycopg://nextcompany_staging_operational:CHANGE_ME@127.0.0.1:5432/nextcompany_staging_operational
PUBLIC_DATABASE_URL=postgresql+psycopg://nextcompany_staging_web:CHANGE_ME@127.0.0.1:5432/nextcompany_staging_public
PUBLIC_IMPORT_DATABASE_URL=postgresql+psycopg://nextcompany_staging_importer:CHANGE_ME@127.0.0.1:5432/nextcompany_staging_public
PUBLIC_ORIGIN=http://127.0.0.1:18080
PUBLIC_TRUSTED_HOSTS=127.0.0.1,localhost
PUBLIC_FORCE_NOINDEX=1
