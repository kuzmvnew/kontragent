# Installed as /etc/nextcompany/operational.env, owner root:mikhail, mode 0640.
DATABASE_URL=postgresql+psycopg://nextcompany_worker:CHANGE_ME@127.0.0.1:5432/nextcompany_operational
FNS_RAW_ROOT=/var/lib/nextcompany/raw/fns
OPERATIONS_BACKUP_DIR=/var/backups/nextcompany-operational
# Optional dedicated disposable database. Never point this at operational DB.
# OPERATIONS_RESTORE_TEST_DATABASE_URL=postgresql+psycopg://nextcompany_restore:CHANGE_ME@127.0.0.1:5432/nextcompany_restore_test
