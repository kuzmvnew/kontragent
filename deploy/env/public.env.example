# Installed as /etc/nextcompany/public.env, root:nextcompany-web mode 0640.
# This is the only environment loaded by the public web service.
PUBLIC_DATABASE_URL=postgresql+psycopg://nextcompany_web:CHANGE_ME@127.0.0.1:5432/nextcompany_public
PUBLIC_ORIGIN=https://nextcompany.pro
PUBLIC_TRUSTED_HOSTS=nextcompany.pro,www.nextcompany.pro,localhost,127.0.0.1
PUBLIC_BACKUP_DIR=/var/backups/nextcompany
PUBLIC_BACKUP_RETENTION_DAYS=14
